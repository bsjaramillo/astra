# =============================================================================
# Astra — Configuración de ejemplo
# =============================================================================
# Copia este archivo a `astra.toml` y edítalo a tu gusto.
# Cualquier campo omitido usa el valor por defecto (ver `Settings::default()`).
#
# Uso:  astra --config astra.toml
#       astra --port 6000 --config mi-sala.toml
# =============================================================================

# --- Servidor --------------------------------------------------------------

# Puerto TCP principal (Ares + WS + Link comparten este puerto).
port = 5009

# Nombre del bot del servidor (aparece en la userlist como ghost).
bot_name = "Astra"

# Nombre y topic de la sala (visibles en el room search).
room_name = "Astra Chat"
room_topic = "Welcome to Astra"

# Password del owner. En el chat: /login <password> → nivel Owner.
# También protege el PANEL DE ADMINISTRACIÓN WEB en http://<host>:<port>/admin
# (mismo puerto que el server). Si está vacío, el panel queda deshabilitado.
owner_password = ""

# Permitir registro de cuentas locales.
allow_registration = true

# Habilitar room search UDP (descubrimiento de otras salas).
roomsearch = true

# Chequeo periódico (cada 6h) de nuevas versiones de Astra contra el registry
# de imágenes (ghcr.io). Cuando hay una versión más nueva, avisa por PM a los
# admins/owners conectados y lo marca en el panel /admin. Pon false para que
# el server no haga requests salientes.
update_check = true

# Auto-owner para quien entra "desde el propio servidor" (equivale al ajuste
# `local_host` de sb0t). Con esto en true, un cliente cuya IP sea loopback o
# igual a `server_ip` entra como OWNER, sin captcha ni cuarentena, y exento
# del ban, de la detección de proxy y del gate onJoinCheck de los scripts.
#
# Es un permiso total concedido por IP: déjalo en false salvo que sepas
# exactamente qué IP llega al server. A diferencia de sb0t, aquí NO cuentan
# los rangos privados (10.x, 192.168.x, 172.16-31.x), porque bajo Docker todas
# las conexiones pueden verse como 172.17.0.1 y eso haría Owner a toda la sala.
local_host = false

# IP pública del servidor, para `local_host`. Vacío = solo loopback.
server_ip = ""

# Idioma por defecto (0 = English).
language = 0

# --- WebSocket (ib0t / panel web) ------------------------------------------

# Habilitar el endpoint WebSocket en el mismo puerto TCP.
# Se desactiva también con la flag CLI `--no-web`.
web_enabled = true

# (Reservado: puerto alternativo para el panel. Actualmente el WS comparte
# el puerto TCP principal; este campo es leído pero no se usa aún.)
web_port = 5010

# --- Almacenamiento --------------------------------------------------------

# Directorio donde Astra guarda la DB SQLite, logs y el seed de rooms.
#
# GeoIP opcional: si colocas bases MMDB en este directorio, se activan
# `/trace` (geolocalización) y el enforcement de `asnban`:
#   - <data_dir>/city.mmdb  → GeoLite2-City o dbip-city-lite (ciudad/país)
#   - <data_dir>/asn.mmdb   → GeoLite2-ASN  o dbip-asn-lite  (ASN)
# Fuentes gratuitas sin cuenta: DB-IP Lite (https://db-ip.com/db/lite.php).
# Sin estos archivos, /trace y asnban degradan a un mensaje honesto.
#
# No hace falta ponerlos a mano: la sección [geoip] de abajo los descarga y
# refresca sola (asn.mmdb incluido). Ver `[geoip]`.
data_dir = "./data"

# --- Link Hub/Leaf (multi-servidor) ---------------------------------------

# Activar como hub: escucha conexiones Link de otros Astra servers.
link_hub_enabled = false
link_hub_port = 5011

# GUID del server: identifica esta sala ante otros servidores en el Link, y es
# el secreto con el que un leaf se autentica contra un hub.
#
# DÉJALO VACÍO: al arrancar, el server genera uno aleatorio y lo escribe aquí
# (igual que hace sb0t). No lo copies de otra sala ni lo compartas — quien lo
# tenga puede hacerse pasar por tu servidor en el Link.
guid = ""

# Leaves confiados para el Link Hub (paridad sb0t).
#
# Si la lista está VACÍA (o ausente), el hub opera en modo LEGACY: acepta
# cualquier leaf que se conecte y la sesión NO se encripta.
#
# Con al menos un entry, solo se aceptan leaves cuyas credentials
# —SHA1(reverse(name ++ guid))— coincidan, y toda la sesión se encripta
# con AES-256-CBC (los strings de cada mensaje viajan cifrados).
#
# IMPORTANTE: el `guid` de cada trusted leaf debe ser EXACTAMENTE el mismo
# string que el `guid` configurado en el astra.toml de ese leaf, y el
# `name` debe coincidir con su `room_name`. Si no, la derivación de la
# clave AES no coincide y el handshake falla.
#
# [[link_trusted_leaves]]
# name = "OtraSala"
# guid = "guid-del-otro-server-1"

# --- Supabase (opcional, syncing de bans con un panel central) ------------

# Si están configurados, Astra sincroniza bans con un backend Supabase.
# Déjalos comentados para operar 100% local.
#
# OJO: TOML no tiene `null`. Escribir `supabase_url = null` invalida el
# archivo ENTERO, no solo esa línea. Para desactivarlos, coméntalos.
# supabase_url = "https://xxxx.supabase.co"
# supabase_key = "clave-anon"

# --- Reporte de bugs/mejoras a GitHub --------------------------------------
# El panel /admin (pestaña "Soporte") puede reportar bugs o ideas al repo
# upstream. Siempre ofrece "Abrir en GitHub" con título y cuerpo pre-rellenados
# (esa vía exige que quien lo envía tenga cuenta de GitHub).
#
# Con un token configurado, además ofrece "Enviar directamente": la sala crea
# el issue server-side y el admin NO necesita cuenta de GitHub. El token lo
# provee el dueño de la sala y nunca se embebe en el binario.
#
# Usá un Personal Access Token *fine-grained* con permiso "Issues: write" SOLO
# sobre el repo de Astra. No uses un token de cuenta con permisos amplios.
[github]
enabled = true
token = ""

# --- Directorio público de salas -------------------------------------------

# Anunciar esta sala en el directorio web, para que se pueda encontrar desde un
# navegador y entrar sin instalar nada.
#
# Está DESACTIVADO por defecto: publicar una sala es decisión de su dueño.
#
# Qué se manda: nombre, topic, descripción, tags, puerto y cuánta gente hay.
# Qué NO se manda, nunca: el `guid` (es el secreto de autenticación del Link;
# viaja un identificador derivado del que no se puede volver al original), la
# `owner_password`, las claves de Supabase, ni un solo dato de los usuarios
# conectados.

[directory]
enabled = false

# Directorio al que anunciarse. Se puede cambiar para usar uno propio.
url = "https://astra.inbizio.xyz"

# Con `false` se pide la baja sin dejar de anunciarse, así que se puede volver
# a publicar desde el panel sin tocar este archivo.
listed = true

# Descripción de la sala en el listado y en su ficha.
description = ""

# Etiquetas para el buscador. Vocabulario cerrado; las que no estén en la lista
# se ignoran: musica, latino, rock, chill, juegos, anime, deportes, amistad,
# ayuda, programacion, cine, 18
tags = []

# Web propia de la sala, si tiene.
website = ""

# Dominio con el que anunciarse, si la sala tiene uno propio con HTTPS. Vacío =
# se usa su IP. Con `tls = true` el cliente web abrirá `wss://` en vez de `ws://`.
public_host = ""
tls = false

# Credencial que emite el directorio en el alta. LA GESTIONA EL SERVIDOR: no
# hace falta escribirla. Si este archivo está montado de solo lectura, no se
# podrá guardar y se pedirá una nueva en cada arranque — la sala sigue
# publicándose igual.
token = ""

# --- Seguridad (defensa en capas anti-DDoS) -------------------------------
# Cada capa tiene sus propios límites. Los defaults son razonables para un
# servidor público pequeño. Ajustar según el tráfico esperado.

[security]

# Capa 1: rate limit de NUEVAS conexiones por IP (sliding window).
max_new_connections_per_ip = 10        # máx conexiones nuevas en la ventana
connection_window_secs = 60            # tamaño de la ventana (segundos)
connection_flood_ban_threshold = 3     # violaciones antes de auto-ban
connection_flood_ban_secs = 300        # duración del auto-ban (5 min)

# Capa 2: máx conexiones TCP simultáneas por IP (logged-in o no).
max_concurrent_per_ip = 5

# Capa 3: timeouts.
handshake_timeout_secs = 15            # tiempo máximo para enviar login
# Red de seguridad para conexiones realmente colgadas. El liveness real lo
# cubren el FASTPING cada 2s + la detección de escritura fallida, así que NO
# bajes esto pensando en "inactividad del usuario": un cliente que solo lee
# (sin escribir) durante más de este tiempo sería desconectado sin aviso.
idle_timeout_secs = 1800               # 30 min

# Capa 4: validación de campos del login.
min_name_length = 1
max_name_length = 30
reject_spam_bots = true                # rechazar 6.6.6.6, 6969 files, etc.

# Capa 5: auto-ban por logins fallidos.
max_failed_logins = 5
failed_login_window_secs = 3600        # ventana de conteo (1h)
failed_login_ban_secs = 3600           # duración del auto-ban (1h)

# --- Captcha (gate opcional para IPs nuevas) ------------------------------
# Si está habilitado, los users que se conectan desde una IP sin historial
# previo en la DB deben resolver un captcha antes de poder hablar en
# público. Responder con /PM al bot.
captcha_enabled = false                # default: deshabilitado (opt-in)
captcha_expiration_secs = 300          # tiempo para resolver (5 min)
captcha_max_attempts = 3               # intentos antes de kickear

# --- Filtro anti-VPN / proxy ----------------------------------------------
# Se configura EN VIVO desde el panel (/admin → Anti-VPN), no desde este
# archivo: la config vive en SQLite para que los cambios rijan sin reiniciar
# (igual que bans/proxies). Por defecto está DESHABILITADO y en modo `report`.
#
# Detecta conexiones desde VPNs, proxies y datacenters combinando:
#   - la base ASN local (`<data_dir>/asn.mmdb`), y
#   - una blocklist CIDR (manual y/o descargada de un feed).
#
# Cuenta con un feed por defecto (X4BNet `lists_vpn`, VPN-only) que se refresca
# cada 24h. Para incluir datacenters, cambiar la URL del feed a la variante
# `output/datacenter/ipv4.txt` del mismo repo.
#
# Acciones ante un hit: report (solo log) · reject (cerrar) · captcha (exigir
# captcha) · quarantine (entrar silenciado). El comando `/vpncheck <ip|nick>`
# (Admin+) diagnostica matchs aunque el filtro esté apagado.
#
# En el panel hay además una allowlist (IPs/rangos exentos, para corregir
# falsos positivos) y un registro de detecciones recientes con un botón
# "Permitir" por detección. Al aplicar `reject`/`quarantine`, la acción se
# reevalúa también sobre los usuarios ya conectados.

# --- GeoIP / ASN (descarga automática) ------------------------------------
# Descarga y refresca las bases MMDB sin reiniciar. Es lo que permite resolver
# el ASN de una IP, del que dependen la parte ASN del filtro anti-VPN y el
# comando /asnban. Por defecto DESHABILITADO (no genera tráfico saliente).
#
# La config vive en SQLite y se edita EN VIVO desde el panel (/admin →
# Anti-VPN → "Base ASN/GeoIP"); esta sección es el valor inicial del primer
# arranque. Una vez que el panel guarda un cambio, manda la DB.
[geoip]
enabled = false                        # interruptor maestro del updater
# URL de la base ASN. El placeholder {YYYY-MM} se resuelve al mes actual (y al
# anterior si el actual aún no está publicado). DB-IP Lite es gratuito, sin
# cuenta, licencia CC-BY. Para MaxMind GeoLite2-ASN, poné la URL directa de tu
# cuenta (sin placeholder).
asn_url = "https://download.db-ip.com/free/dbip-asn-lite-{YYYY-MM}.mmdb.gz"
# URL de la base de ciudad (opcional; vacío = no descargar). Habilita /trace
# con ciudad/país. La de DB-IP pesa ~124 MB.
city_url = ""
# Horas entre comprobaciones. DB-IP publica mensualmente; 24h es buen balance.
refresh_hours = 24
